# Chat App Configuration
# Copy this file to .env and fill in your actual values

# Your Databricks workspace URL (without https://)
DATABRICKS_HOST=your-workspace.cloud.databricks.com

# Your personal access token from Databricks
DATABRICKS_TOKEN=your-personal-access-token

# Multi-Agent Supervisor Endpoint
SERVING_ENDPOINT=mas-6c04fa76-endpoint

# MLflow experiment (optional, for logging)
MLFLOW_EXPERIMENT=mas-6c04fa76-dev-experiment

# App Configuration
APP_NAME=Multi-Agent Chat App
APP_DESCRIPTION=Chat interface for the Multi-Agent Supervisor
