# ================================
# Databricks Direct Write App - Environment Configuration Template
# ================================
#
# This file provides a template for environment variables needed by the app.
# Copy this file to .env or set these variables in your Databricks Apps configuration.
#
# IMPORTANT: Never commit actual credentials to version control!

# ================================
# WRITER CONFIGURATION
# ================================

# Enable/disable specific writers
# Values: "true" or "false"
ENABLE_ZEROBUS_WRITER=true
ENABLE_DIRECT_DELTA_WRITER=true

# ================================
# DATABRICKS AUTHENTICATION
# ================================

# Databricks workspace URL
# Example: https://your-workspace.cloud.databricks.com
DATABRICKS_HOST=https://e2-demo-field-eng.cloud.databricks.com

# Personal Access Token (PAT) - Primary authentication method
# Databricks Apps automatically provides this in the runtime environment
# DATABRICKS_TOKEN=dapi...

# ================================
# SERVICE PRINCIPAL CONFIGURATION (for Zerobus)
# ================================

# Service Principal Client ID (UUID format)
# Required for Zerobus Direct Write API
# DATABRICKS_CLIENT_ID=your-service-principal-client-id

# Service Principal Client Secret
# Required for Zerobus Direct Write API
# DATABRICKS_CLIENT_SECRET=your-service-principal-secret

# ================================
# DATABASE CONFIGURATION
# ================================

# Default catalog name
DEFAULT_CATALOG=kaustavpaul_demo

# Default schema name
DEFAULT_SCHEMA=zerobus_delta

# ================================
# ZEROBUS CONFIGURATION
# ================================

# Zerobus server endpoint (region-specific)
# Format: <cluster-id>.zerobus.<region>.cloud.databricks.com
ZEROBUS_ENDPOINT=6051921418418893.zerobus.us-west-2.staging.cloud.databricks.com

# Alternative Zerobus endpoint format (if needed)
# ZEROBUS_ALT_ENDPOINT=6051921418418893.ingest.staging.cloud.databricks.com

# ================================
# SQL WAREHOUSE CONFIGURATION (for Direct Delta Writer)
# ================================

# SQL Warehouse ID for Direct Delta Writer
# Get this from your Databricks workspace SQL Warehouses page
SQL_WAREHOUSE_ID=dd43ee29fedd958d

# SQL statement execution timeout (in seconds)
# Must be between 5 and 50 seconds
SQL_WAIT_TIMEOUT=45s

# ================================
# APPLICATION CONFIGURATION
# ================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application port (default: 8000 for Databricks Apps)
APP_PORT=8000

# Enable debug endpoints (set to "false" in production)
ENABLE_DEBUG_ENDPOINTS=true

